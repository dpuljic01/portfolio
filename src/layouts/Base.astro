---
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Domagoj Puljic — Backend Engineer, Zurich',
  description = 'Backend engineer based in Zurich specialising in Python APIs, data pipelines, and cloud infrastructure. Available for freelance projects and full-time roles in Switzerland.',
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{title}</title>
  </head>
  <body class="overflow-x-hidden bg-zinc-950 text-zinc-100 antialiased">
    <slot />
    <Analytics />
  </body>
</html>
